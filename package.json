{
	"name": "snapfluensseri",
	"version": "0.0.0",
	"description": "A Telegram bot that periodically picks a Snapfluencer from opted-in group members.",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	},
	"pnpm": {
		"overrides": {
			"esbuild@<=0.24.2": "0.25.12",
			"esbuild@>=0.27.3 <0.28.1": "0.28.1",
			"vite@>=7.0.0 <7.3.5": "7.3.5"
		}
	},
	"scripts": {
		"check": "pnpm run lint && pnpm run typecheck && pnpm run test:run",
		"deploy": "wrangler deploy",
		"deploy:production": "pnpm run db:migrate:remote && pnpm run deploy",
		"dev": "wrangler dev --test-scheduled",
		"start": "wrangler dev --test-scheduled",
		"cf-typegen": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply snapfluencer --local",
		"db:migrate:remote": "wrangler d1 migrations apply snapfluencer --remote",
		"format": "biome format --write src package.json tsconfig.json wrangler.jsonc",
		"lint": "biome check src package.json tsconfig.json wrangler.jsonc",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/luxon": "3.7.5",
		"@types/node": "26.5.1",
		"dotenv": "17.4.2",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2",
		"vitest": "5.0.0",
		"wrangler": "4.131.1"
	},
	"dependencies": {
		"cron-parser": "5.10.0",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"luxon": "3.7.2",
		"telegraf": "4.16.3",
		"zod": "4.5.4"
	}
}
